# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and update the values

# Backend API URL
# Development: leave empty to use Vite proxy (/api -> localhost:5000)
# Alternate local backend: http://localhost:5001
# Production: https://your-backend-domain.vercel.app
VITE_API_URL=

# Application Environment (development or production)
VITE_ENV=development

# Optional: Uncomment for production
# VITE_API_URL=https://hotel-management-vk6w.vercel.app
