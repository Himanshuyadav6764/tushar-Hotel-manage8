# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Local MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/hotel-management

# Admin User Credentials (for seeding)
ADMIN_EMAIL=admin@bireena.com
ADMIN_PASSWORD=admin123 
BIREENA_ADMIN_EMAIL=admin@bireena.com
BIREENA_ADMIN_PASSWORD=admin123

# Super Admin Credentials
SUPER_ADMIN_EMAIL=superadmin@bireena.com
SUPER_ADMIN_PASSWORD=superadmin123

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# Server Port (default: 5000)
PORT=5000

# Node Environment (development, production, testing)
NODE_ENV=development

# ============================================================
# FRONTEND CONFIGURATION (CORS)
# ============================================================
# Frontend URL for CORS - Update with your actual frontend URL
FRONTEND_URL=http://localhost:3001

# ============================================================
# SECURITY (Optional)
# ============================================================
# JWT Secret for authentication (generate a strong random string)
JWT_SECRET=bireena_secret_key_2024

# CORS allowed origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# App-level firewall controls
FIREWALL_ENABLED=true
# Optional allowlist: when set, only these client IPs are allowed (comma-separated)
FIREWALL_ALLOW_IPS=
# Optional blocklist: these IPs are always blocked (comma-separated)
FIREWALL_BLOCK_IPS=
# Optional scanner/bot signatures to block in user-agent (comma-separated)
FIREWALL_BLOCK_USER_AGENTS=sqlmap,nikto,acunetix,nessus,nmap,burp,masscan,zgrab
# Optional regex list to block specific paths (comma-separated regex)
FIREWALL_BLOCK_PATH_PATTERNS=
# Block dangerous HTTP methods
FIREWALL_BLOCK_METHODS=TRACE,TRACK,CONNECT

# Enforce HTTPS redirects in production when behind proxy/load balancer
FORCE_HTTPS=false

# 32-byte encryption key for sensitive DB fields (64 hex chars recommended)
DATA_ENCRYPTION_KEY=

# Default tenant fallback for legacy/public endpoints
DEFAULT_HOTEL_ID=6997228b6026c13da9b0c5e3
DEFAULT_TENANT_DB=hotel-management
